pkgbase=steelseries-linux
pkgname=('steelseries-linux' 'steelseries-linux-gui')
pkgver=0.4.0
pkgrel=1
pkgdesc="Linux configuration tools for supported SteelSeries devices"
arch=('x86_64')
url="https://github.com/3efeoyunda1/steelseries-linux"
license=('MIT')
options=('!lto')
makedepends=('cargo' 'rust' 'pkgconf')
source=("${pkgbase}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${pkgbase}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgbase}-${pkgver}"
  CARGO_TARGET_DIR="${srcdir}/target" cargo build --release --locked \
    -p steelseries-cli -p steelseries-gui
}

check() {
  cd "${pkgbase}-${pkgver}"
  CARGO_TARGET_DIR="${srcdir}/target" cargo test --workspace --locked
}

package_steelseries-linux() {
  cd "${pkgbase}-${pkgver}"

  pkgdesc="Linux configuration CLI for supported SteelSeries devices"
  depends=('glibc' 'gcc-libs' 'systemd')
  install=steelseries-linux.install

  install -Dm755 "${srcdir}/target/release/steelseriesctl" \
    "${pkgdir}/usr/bin/steelseriesctl"
  install -Dm644 udev/70-steelseries-linux.rules \
    "${pkgdir}/usr/lib/udev/rules.d/70-steelseries-linux.rules"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

package_steelseries-linux-gui() {
  cd "${pkgbase}-${pkgver}"

  pkgdesc="Graphical application for SteelSeries Linux"
  depends=("steelseries-linux=${pkgver}-${pkgrel}" 'glibc' 'gcc-libs' 'fontconfig')

  install -Dm755 "${srcdir}/target/release/steelseries-gui" \
    "${pkgdir}/usr/bin/steelseries-gui"
  install -Dm644 assets/app/steelseries-linux.desktop \
    "${pkgdir}/usr/share/applications/steelseries-linux.desktop"
  install -Dm644 assets/app/steelseries-linux.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/steelseries-linux.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
