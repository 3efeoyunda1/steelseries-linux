pkgbase=steelseries-linux
pkgname=('steelseries-linux' 'steelseries-linux-gui')
pkgver=0.4.1
pkgrel=1
pkgdesc="Linux configuration tools for supported SteelSeries devices"
arch=('x86_64')
url="https://github.com/3efeoyunda1/steelseries-linux"
license=('MIT AND BSD-3-Clause')
options=('!lto' '!debug')
makedepends=('cargo' 'rust' 'pkgconf' 'fontconfig' 'systemd')
source=("${pkgbase}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${pkgbase}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgbase}-${pkgver}"
  RUSTFLAGS="${RUSTFLAGS:+${RUSTFLAGS} }--remap-path-prefix=${srcdir}=/usr/src/steelseries-linux" \
    CARGO_TARGET_DIR="${srcdir}/target" cargo build --release --locked \
    -p steelseries-cli -p steelseries-gui
  STEELSERIESCTL_GENERATE_COMPLETIONS="${srcdir}/target/completions" \
    "${srcdir}/target/release/steelseriesctl"
}

check() {
  cd "${pkgbase}-${pkgver}"
  CARGO_TARGET_DIR="${srcdir}/target" cargo test --workspace --locked
}

package_steelseries-linux() {
  cd "${pkgbase}-${pkgver}"

  pkgdesc="Linux configuration CLI for supported SteelSeries devices"
  depends=('glibc' 'gcc-libs' 'systemd')
  install=steelseries-linux.install

  install -Dm755 "${srcdir}/target/release/steelseriesctl" \
    "${pkgdir}/usr/bin/steelseriesctl"
  install -Dm644 "${srcdir}/target/completions/steelseriesctl" \
    "${pkgdir}/usr/share/bash-completion/completions/steelseriesctl"
  install -Dm644 "${srcdir}/target/completions/_steelseriesctl" \
    "${pkgdir}/usr/share/zsh/site-functions/_steelseriesctl"
  install -Dm644 "${srcdir}/target/completions/steelseriesctl.fish" \
    "${pkgdir}/usr/share/fish/vendor_completions.d/steelseriesctl.fish"
  install -Dm644 udev/70-steelseries-linux.rules \
    "${pkgdir}/usr/lib/udev/rules.d/70-steelseries-linux.rules"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES.md"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

package_steelseries-linux-gui() {
  cd "${pkgbase}-${pkgver}"

  pkgdesc="Graphical application for SteelSeries Linux"
  license=('MIT AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND Unicode-3.0 AND Unlicense AND Zlib AND LicenseRef-Slint-Royalty-free-2.0 AND LicenseRef-SteelSeries-Images-Unverified')
  depends=("steelseries-linux=${pkgver}-${pkgrel}" 'glibc' 'gcc-libs' 'fontconfig' 'wayland' 'libxkbcommon' 'libx11' 'libxcursor' 'libxi' 'libxrandr')

  install -Dm755 "${srcdir}/target/release/steelseries-linux-gui" \
    "${pkgdir}/usr/bin/steelseries-linux-gui"
  install -Dm644 assets/app/steelseries-linux-gui.desktop \
    "${pkgdir}/usr/share/applications/steelseries-linux-gui.desktop"
  install -Dm644 assets/app/steelseries-linux-gui.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/steelseries-linux-gui.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES.md"
  install -Dm644 crates/vendor/softbuffer/LICENSE-MIT "${pkgdir}/usr/share/licenses/${pkgname}/softbuffer-MIT"
}
