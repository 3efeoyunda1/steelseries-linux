_steelseries_reload_udev() {
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
  fi
}

_steelseries_trigger_hidraw() {
  if command -v udevadm >/dev/null 2>&1; then
    udevadm trigger --subsystem-match=hidraw --action=change >/dev/null 2>&1 || true
  fi
}

post_install() {
  _steelseries_reload_udev
  _steelseries_trigger_hidraw
  echo "Reconnect the SteelSeries mouse/receiver if its access permissions have not updated."
}

post_upgrade() {
  post_install
}

post_remove() {
  _steelseries_reload_udev
  _steelseries_trigger_hidraw
}
