import { LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { AppButton, ButtonSize, ButtonVariant } from "components/app-button.slint";
import { BatteryIndicator } from "components/battery-indicator.slint";
import { ToggleControl } from "components/toggle-control.slint";
import { SelectControl } from "components/select-control.slint";
import { SliderNumericControl } from "components/slider-numeric-control.slint";
import { ButtonMetrics, ControlMetrics } from "theme.slint";

export struct DeviceItem {
    name: string,
    connection: string,
    connection-key: string,
    model-key: string,
    id: string,
    identity-label: string,
    battery-available: bool,
    battery-percentage: int,
    battery-charging: bool,
    battery-icon: image,
}

export struct KnownDeviceItem {
    id: string,
    name: string,
    connection: string,
    active: bool,
}

export struct DashboardRow {
    label: string,
    value: string,
    detail: string,
    active: bool,
    x: int,
    y: int,
    separate: bool,
    raw-value: string,
    persisted: bool,
    option-index: int,
    x-position: float,
    y-position: float,
    persisted-x: int,
    persisted-y: int,
}

export struct DpiReferenceItem {
    value: int,
    label: string,
    tick-position: float,
    label-position: float,
}

export struct DashboardData {
    device-name: string,
    connection: string,
    connection-key: string,
    device-id: string,
    device-id-label: string,
    model-key: string,
    show-battery: bool,
    battery: string,
    battery-percentage: int,
    battery-charging: bool,
    battery-icon: image,
    show-dpi: bool,
    active-dpi: string,
    dpi-capabilities: string,
    dpi-independent-axes: bool,
    dpi-min: int,
    dpi-max: int,
    dpi-step: int,
    dpi-max-stages: int,
    show-lod: bool,
    active-lod: string,
    lod-capabilities: string,
    show-polling: bool,
    show-wireless-polling: bool,
    show-wired-polling: bool,
    wireless-polling: string,
    wired-polling: string,
    wireless-polling-hz: int,
    wired-polling-hz: int,
    wireless-polling-primary: bool,
    wired-polling-primary: bool,
    wireless-polling-index: int,
    wired-polling-index: int,
    polling-capabilities: string,
    show-power: bool,
    show-low-power-mode: bool,
    show-low-power-polling: bool,
    show-sleep-timer: bool,
    show-auto-low-power: bool,
    low-power-mode: string,
    low-power-enabled: bool,
    low-power-polling: string,
    low-power-polling-hz: int,
    low-power-polling-index: int,
    sleep-timer: string,
    sleep-timer-edit: int,
    sleep-timer-current: int,
    sleep-timer-min: int,
    sleep-timer-max: int,
    sleep-timer-step: int,
    auto-low-power: string,
    auto-low-power-enabled: bool,
    auto-low-power-threshold: string,
    auto-low-power-threshold-edit: int,
    auto-low-power-threshold-current: int,
    auto-low-power-threshold-min: int,
    auto-low-power-threshold-max: int,
    auto-low-power-threshold-step: int,
    show-wireless-stability: bool,
    wireless-stability: string,
    wireless-stability-enabled: bool,
    show-bluetooth-smoothing: bool,
    bluetooth-smoothing: string,
    bluetooth-smoothing-enabled: bool,
    show-scroll-jump: bool,
    scroll-jump: string,
    scroll-jump-enabled: bool,
    scroll-jump-delay: string,
    scroll-jump-delay-edit: int,
    scroll-jump-delay-current: int,
    scroll-jump-capabilities: string,
    scroll-jump-delay-min: int,
    scroll-jump-delay-max: int,
    scroll-jump-delay-step: int,
    scroll-jump-delay-unit: string,
}

component DeviceCard inherits Rectangle {
    in property <DeviceItem> device;
    callback selected;

    height: 116px;
    border-radius: 10px;
    border-width: 1px;
    border-color: card-area.has-hover ? #e87524 : #343434;
    background: card-area.pressed ? #292929 : card-area.has-hover ? #252525 : #202020;

    HorizontalLayout {
        padding: 18px;
        spacing: 8px;
        VerticalLayout {
            spacing: 7px;
            horizontal-stretch: 1;
            Text { text: root.device.name; color: #f4f4f4; font-size: 18px; font-weight: 600; }
            Text { text: root.device.connection; color: #f18a42; font-size: 14px; vertical-alignment: center; }
            Text {
                text: root.device.identity-label;
                color: #929292;
                font-size: 11px;
                overflow: elide;
            }
        }
        if root.device.battery-available: BatteryIndicator {
            icon: root.device.battery-icon;
            text: root.device.battery-percentage + "%";
            text-color: #cfcfcf;
            text-size: 12px;
            text-weight: 400;
            horizontal-stretch: 0;
            cross-axis-self-alignment: center;
        }
    }
    card-area := TouchArea { clicked => { root.selected(); } }
}

component BatteryOverviewCard inherits Rectangle {
    in property <string> value;
    in property <bool> available;
    in property <int> percentage;
    in property <bool> charging;
    in property <image> battery-icon;
    height: 82px;
    border-radius: 9px;
    border-width: 1px;
    border-color: #343434;
    background: #1e1e1e;
    VerticalLayout {
        padding: 13px;
        spacing: 6px;
        // Match the title/value slot distribution of the other overview cards.
        Text { text: "Battery"; color: #8f8f8f; font-size: 11px; vertical-stretch: 1; }
        Rectangle {
            min-height: 20px;
            max-height: root.height;
            vertical-stretch: 1;
            BatteryIndicator {
                y: 0px;
                width: parent.width;
                height: 20px;
                icon: root.battery-icon;
                text: root.value;
            }
        }
    }
}

component OverviewCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> primary: false;

    height: 82px;
    border-radius: 9px;
    border-width: 1px;
    border-color: primary ? #e87524 : #343434;
    background: #1e1e1e;
    VerticalLayout {
        padding: 13px;
        spacing: 6px;
        Text { text: root.title; color: #8f8f8f; font-size: 11px; }
        Text { text: root.value; color: root.primary ? #f18a42 : #f1f1f1; font-size: 15px; font-weight: 600; overflow: elide; }
    }
}

component DpiSliderControl inherits VerticalLayout {
    in property <string> label;
    in property <int> value;
    in property <float> position;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step;
    in property <bool> enabled: true;
    in property <int> reset-generation;
    in property <[DpiReferenceItem]> references;
    private property <float> slider-position: root.position;
    private property <bool> slider-active: false;
    private property <string> original-text: "" + root.value;
    private property <string> edit-text: "" + root.value;
    private property <bool> edit-session-active: false;
    private property <bool> text-dirty: false;
    private property <bool> cancelled: false;
    private property <bool> editor-has-focus: editor.has-focus;
    callback position-previewed(float);
    callback position-released(float);
    callback value-committed(string) -> bool;
    callback reference-selected(int);
    spacing: 5px;

    changed reset-generation => {
        if root.edit-session-active {
            root.cancelled = true;
            root.edit-text = root.original-text;
            root.slider-position = root.position;
            root.text-dirty = false;
            root.edit-session-active = false;
            editor.clear-focus();
            root.cancelled = false;
        }
    }

    changed value => {
        if !root.edit-session-active {
            root.edit-text = "" + root.value;
        }
    }
    changed position => {
        if !root.slider-active {
            root.slider-position = root.position;
        }
    }
    changed editor-has-focus => {
        if root.editor-has-focus {
            if !root.edit-session-active {
                root.original-text = "" + root.value;
                root.edit-text = "" + root.value;
                root.text-dirty = false;
                root.cancelled = false;
                root.edit-session-active = true;
            }
        } else if root.edit-session-active {
            if root.cancelled {
                root.edit-text = root.original-text;
                root.text-dirty = false;
                root.cancelled = false;
                root.edit-session-active = false;
            } else if dpi-slider.has-focus {
                root.edit-text = "" + root.value;
                root.text-dirty = false;
                root.edit-session-active = false;
            } else if root.text-dirty {
                if root.value-committed(root.edit-text) {
                    root.text-dirty = false;
                    root.edit-session-active = false;
                } else {
                    editor.focus();
                }
            } else {
                root.edit-session-active = false;
            }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        Text { text: root.label; color: #a0a0a0; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            horizontal-stretch: 0;
            max-width: self.preferred-width;
            editor := LineEdit {
                width: ControlMetrics.numeric-input-width;
                horizontal-stretch: 0;
                text: root.edit-text;
                enabled: root.enabled;
                input-type: InputType.number;
                horizontal-alignment: center;
                edited(text) => {
                    root.edit-text = text;
                    root.text-dirty = text != root.original-text;
                }
                accepted(text) => {
                    root.edit-text = text;
                    root.text-dirty = text != root.original-text;
                    if !root.text-dirty {
                        root.edit-session-active = false;
                        self.clear-focus();
                    } else if root.value-committed(text) {
                        root.text-dirty = false;
                        root.edit-session-active = false;
                        self.clear-focus();
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape && root.edit-session-active {
                        root.cancelled = true;
                        root.edit-text = root.original-text;
                        root.slider-position = root.position;
                        self.clear-focus();
                        return accept;
                    }
                    return reject;
                }
            }
            Text { text: "DPI"; color: #8c8c8c; font-size: 11px; vertical-alignment: center; }
        }
    }
    dpi-slider := Slider {
        minimum: 0;
        maximum: 1;
        step: 0;
        value <=> root.slider-position;
        enabled: root.enabled;
        changed(value) => {
            root.slider-active = true;
            root.edit-session-active = false;
            root.text-dirty = false;
            root.cancelled = false;
            root.position-previewed(value);
        }
        released(value) => {
            root.slider-active = false;
            root.position-released(value);
        }
    }
    reference-strip := Rectangle {
        property <length> track-inset: 8px;
        property <length> track-width: self.width - 2 * self.track-inset;
        height: 30px;
        background: transparent;
        for reference in root.references: Rectangle {
            x: reference.tick-position <= 0
                ? reference-strip.track-inset
                : reference.tick-position >= 1
                    ? reference-strip.track-inset + reference-strip.track-width - 44px
                    : Math.max(reference-strip.track-inset, Math.min(reference-strip.track-inset + reference-strip.track-width - 44px, reference-strip.track-inset + reference.label-position * reference-strip.track-width - 22px));
            y: 8px;
            width: 44px;
            height: 18px;
            background: transparent;
            Text {
                text: reference.label;
                color: #777777;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.reference-selected(reference.value); } }
        }
        for reference in root.references: Rectangle {
            x: reference-strip.track-inset + reference.tick-position * reference-strip.track-width;
            y: 0px;
            width: 1px;
            height: 7px;
            background: #666666;
        }
    }
}

export component AppWindow inherits Window {
    title: "SteelSeries Linux";
    icon: @image-url("../../../assets/app/steelseries-linux-gui.svg");
    in-out property <int> fixed-window-width: 1;
    in-out property <int> fixed-window-height: 1;
    min-width: root.fixed-window-width * 1px;
    max-width: root.fixed-window-width * 1px;
    min-height: root.fixed-window-height * 1px;
    max-height: root.fixed-window-height * 1px;
    maximized: false;
    full-screen: false;
    background: #111111;

    in-out property <string> view-state: "loading";
    in-out property <[DeviceItem]> devices;
    in-out property <[KnownDeviceItem]> known-devices;
    in-out property <bool> tray-enabled: true;
    in-out property <int> tray-icon-theme-index: 1;
    in-out property <int> refresh-interval-index: 2;
    in-out property <bool> start-at-login: false;
    in-out property <string> settings-error;
    in-out property <string> error-message;
    in-out property <string> selected-name;
    in-out property <string> selected-connection;
    in-out property <string> selected-connection-key;
    in-out property <string> selected-id;
    in-out property <string> selected-model-key;
    in-out property <DashboardData> dashboard;
    in-out property <[DashboardRow]> dpi-rows;
    in-out property <[DpiReferenceItem]> dpi-references;
    in-out property <[string]> lod-options;
    in-out property <[string]> wireless-polling-options;
    in-out property <[string]> wired-polling-options;
    in-out property <[string]> low-power-polling-options;
    in-out property <bool> mutation-busy: false;
    in-out property <string> mutation-error;
    in-out property <string> dpi-error;
    in-out property <int> page-generation: 0;

    callback refresh-requested;
    callback device-selected(int);
    callback dashboard-refresh-requested;
    callback back-requested;
    callback dpi-position-previewed(int, string, float);
    callback dpi-position-released(int, string, float);
    callback dpi-value-edited(int, string, string) -> bool;
    callback dpi-reference-selected(int, string, int);
    callback dpi-apply-requested(int);
    callback dpi-separate-requested(int);
    callback dpi-add-requested;
    callback dpi-remove-requested(int);
    callback active-dpi-requested(int);
    callback lod-selected(int, int);
    callback choice-selected(string, int);
    callback toggle-requested(string);
    callback numeric-value-previewed(string, int);
    callback numeric-value-edited(string, string) -> bool;
    callback settings-requested;
    callback settings-back-requested;
    callback tray-enabled-changed;
    callback tray-icon-theme-selected(int);
    callback refresh-interval-selected(int);
    callback start-at-login-changed;
    callback priority-move-requested(int, int);

    VerticalLayout {
        padding: 26px;
        spacing: 18px;

        if root.view-state != "dashboard" && root.view-state != "device-loading" && root.view-state != "device-error": HorizontalLayout {
            height: 50px;
            VerticalLayout {
                spacing: 2px;
                Text { text: "SteelSeries Linux"; color: #f7f7f7; font-size: 25px; font-weight: 700; }
                Text { text: "Device control"; color: #8d8d8d; font-size: 12px; }
            }
        }

        if root.view-state == "loading": Rectangle {
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text { text: "Searching for SteelSeries devices..."; color: #dadada; font-size: 17px; horizontal-alignment: center; }
                Text { text: "steelseriesctl is checking supported physical devices."; color: #777777; font-size: 12px; horizontal-alignment: center; }
            }
        }

        if root.view-state == "empty": Rectangle {
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 18px;
                Text { text: "No supported SteelSeries devices found."; color: #dedede; font-size: 17px; horizontal-alignment: center; }
                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    AppButton { size: ButtonSize.large; variant: ButtonVariant.neutral; text: "Refresh"; clicked => { root.refresh-requested(); } }
                }
            }
        }

        if root.view-state == "error": Rectangle {
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text { text: "Could not load devices"; color: #f0f0f0; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                Text { text: root.error-message; color: #b5b5b5; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    AppButton { size: ButtonSize.large; variant: ButtonVariant.accent; text: "Retry"; clicked => { root.refresh-requested(); } }
                }
            }
        }

        if root.view-state == "list": VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                Text { text: "Devices"; color: #eeeeee; font-size: 20px; font-weight: 600; vertical-alignment: center; }
                Rectangle { background: transparent; horizontal-stretch: 1; }
                AppButton { size: ButtonSize.toolbar; variant: ButtonVariant.toolbar; text: "Settings"; clicked => { root.settings-requested(); } }
                AppButton { size: ButtonSize.toolbar; variant: ButtonVariant.toolbar; text: "⟳  Refresh"; clicked => { root.refresh-requested(); } }
            }
            Rectangle {
                background: transparent;
                VerticalLayout {
                    spacing: 12px;
                    for device[index] in root.devices: DeviceCard {
                        device: device;
                        selected => { root.device-selected(index); }
                    }
                }
            }
        }

        if root.view-state == "settings": VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                Text { text: "Settings"; color: #eeeeee; font-size: 20px; font-weight: 600; vertical-alignment: center; }
                Rectangle { background: transparent; horizontal-stretch: 1; }
                AppButton { size: ButtonSize.toolbar; variant: ButtonVariant.toolbar; text: "←  Devices"; clicked => { root.settings-back-requested(); } }
            }
            if root.settings-error != "": Rectangle {
                height: 38px;
                vertical-stretch: 0;
                border-radius: 6px;
                border-width: 1px;
                border-color: #8d4535;
                background: #2b1d1a;
                Text { text: root.settings-error; color: #efb3a5; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
            settings-scroll := ScrollView {
                mouse-drag-pan-enabled: false;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-height: settings-content.preferred-height;
                content-width: settings-scroll.width;
                settings-content := VerticalLayout {
                    width: settings-scroll.width;
                    vertical-stretch: 0;
                    spacing: 12px;
                    Rectangle {
                        vertical-stretch: 0;
                        border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                        VerticalLayout {
                            padding: 14px; spacing: 9px;
                            Text { text: "General"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                            ToggleControl { label: "System Tray"; label-min-width: 140px; value: root.tray-enabled; toggled => { root.tray-enabled-changed(); } }
                            SelectControl {
                                label: "Tray icon";
                                label-min-width: 140px;
                                options: ["Colored", "Monochrome"];
                                current-index: root.tray-icon-theme-index;
                                selected(index) => { root.tray-icon-theme-selected(index); }
                            }
                            SelectControl {
                                label: "Refresh interval";
                                label-min-width: 140px;
                                options: ["15 seconds", "30 seconds", "60 seconds", "120 seconds", "300 seconds"];
                                current-index: root.refresh-interval-index;
                                selected(index) => { root.refresh-interval-selected(index); }
                            }
                            ToggleControl {
                                label: "Start at login";
                                label-min-width: 140px;
                                value: root.start-at-login;
                                toggled => { root.start-at-login-changed(); }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 0;
                        border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                        VerticalLayout {
                            padding: 14px; spacing: 9px;
                            Text { text: "Device priority"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                            if root.known-devices.length == 0: Text { text: "No previously known devices."; color: #888888; font-size: 12px; }
                            for device[index] in root.known-devices: Rectangle {
                                height: 50px; vertical-stretch: 0; border-radius: 6px; background: #222222;
                                HorizontalLayout {
                                    padding: 9px; spacing: 9px;
                                    Text { width: 22px; text: index + 1 + "."; color: #888888; font-size: 12px; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: device.name; color: #e4e4e4; font-size: 13px; font-weight: 550; }
                                        Text { text: device.active ? device.connection : "Offline"; color: device.active ? #b5b5b5 : #777777; font-size: 11px; }
                                    }
                                    Rectangle { background: transparent; horizontal-stretch: 1; }
                                    AppButton { size: ButtonSize.compact; width: ButtonMetrics.priority-arrow-width; variant: ButtonVariant.neutral; text: "↑"; enabled: index > 0; clicked => { root.priority-move-requested(index, -1); } }
                                    AppButton { size: ButtonSize.compact; width: ButtonMetrics.priority-arrow-width; variant: ButtonVariant.neutral; text: "↓"; enabled: index + 1 < root.known-devices.length; clicked => { root.priority-move-requested(index, 1); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.view-state == "device-loading": Rectangle {
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text { text: "Loading device information..."; color: #dadada; font-size: 17px; horizontal-alignment: center; }
                Text { text: root.selected-name; color: #777777; font-size: 12px; horizontal-alignment: center; }
            }
        }

        if root.view-state == "device-error": Rectangle {
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text { text: "Device unavailable"; color: #f0f0f0; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                Text { text: root.error-message; color: #b5b5b5; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    spacing: 10px;
                    AppButton { size: ButtonSize.large; variant: ButtonVariant.neutral; text: "Back to Devices"; clicked => { root.back-requested(); } }
                    AppButton { size: ButtonSize.large; variant: ButtonVariant.accent; text: "Retry"; clicked => { root.dashboard-refresh-requested(); } }
                }
            }
        }

        if root.view-state == "dashboard": VerticalLayout {
            spacing: 14px;
            VerticalLayout {
                height: 52px;
                spacing: 3px;
                Text { text: root.dashboard.device-name; color: #f4f4f4; font-size: 22px; font-weight: 700; }
                Text { text: root.dashboard.device-id-label; color: #999999; font-size: 12px; }
            }
            HorizontalLayout {
                height: 30px;
                spacing: 10px;
                AppButton { size: ButtonSize.toolbar; variant: ButtonVariant.toolbar; text: "←  Devices"; enabled: !root.mutation-busy; clicked => { root.back-requested(); } }
                Rectangle { background: transparent; horizontal-stretch: 1; }
                AppButton { size: ButtonSize.toolbar; variant: ButtonVariant.toolbar; text: "⟳  Refresh"; enabled: !root.mutation-busy; clicked => { root.dashboard-refresh-requested(); } }
            }

            if root.mutation-error != "": Rectangle {
                height: 38px; border-radius: 6px; border-width: 1px; border-color: #8d4535; background: #2b1d1a;
                Text { text: root.mutation-error; color: #efb3a5; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }

            scroll-container := Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                background: transparent;
                clip: false;

                dashboard-scroll := ScrollView {
                    x: 0px;
                    y: 0px;
                    width: scroll-container.width + 20px;
                    height: scroll-container.height;
                    preferred-width: 0px;
                    content-height: dashboard-content.preferred-height;
                    content-width: scroll-container.width;
                    mouse-drag-pan-enabled: false;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    dashboard-content := VerticalLayout {
                        width: scroll-container.width;
                        spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        OverviewCard { title: "Connection"; value: root.dashboard.connection; }
                        if root.dashboard.show-battery: BatteryOverviewCard {
                            value: root.dashboard.battery;
                            available: root.dashboard.battery-percentage >= 0;
                            percentage: root.dashboard.battery-percentage;
                            charging: root.dashboard.battery-charging;
                            battery-icon: root.dashboard.battery-icon;
                        }
                        if root.dashboard.show-dpi: OverviewCard { title: "Active DPI"; value: root.dashboard.active-dpi; }
                        if root.dashboard.show-polling: OverviewCard {
                            title: root.dashboard.wired-polling-primary ? "Wired Polling" : "Wireless Polling";
                            value: root.dashboard.wired-polling-primary ? root.dashboard.wired-polling : root.dashboard.wireless-polling;
                        }
                        if root.dashboard.show-lod: OverviewCard { title: "Active LOD"; value: root.dashboard.active-lod; }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            vertical-stretch: 0;

                            if root.dashboard.show-dpi: Rectangle {
                                border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                                VerticalLayout {
                                    padding: 15px; spacing: 8px;
                                    Text { text: "DPI"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                                    if root.dpi-error != "": Text { text: root.dpi-error; color: #ef9b87; font-size: 11px; wrap: word-wrap; }
                                    for row[index] in root.dpi-rows: Rectangle {
                                        min-height: row.separate ? 286px : 222px;
                                        border-radius: 6px;
                                        border-width: row.active ? 1px : 0px;
                                        border-color: #d96f25;
                                        background: row.active ? #2d2926 : #222222;
                                        VerticalLayout {
                                            padding: 12px; spacing: 9px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: row.label; color: row.active ? #f18a42 : #e0e0e0; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                                if !row.persisted: Text { text: "Unsaved"; color: #d49a62; font-size: 10px; vertical-alignment: center; }
                                            }
                                            if !row.separate: DpiSliderControl {
                                                label: "DPI"; value: row.x; position: row.x-position;
                                                minimum: root.dashboard.dpi-min; maximum: root.dashboard.dpi-max; step: root.dashboard.dpi-step; references: root.dpi-references;
                                                enabled: !root.mutation-busy;
                                                reset-generation: root.page-generation;
                                                position-previewed(position) => { root.dpi-position-previewed(index, "both", position); }
                                                position-released(position) => { root.dpi-position-released(index, "both", position); }
                                                value-committed(value) => { root.dpi-value-edited(index, "both", value) }
                                                reference-selected(value) => { root.dpi-reference-selected(index, "both", value); }
                                            }
                                            if row.separate: DpiSliderControl {
                                                label: "X"; value: row.x; position: row.x-position;
                                                minimum: root.dashboard.dpi-min; maximum: root.dashboard.dpi-max; step: root.dashboard.dpi-step; references: root.dpi-references;
                                                enabled: !root.mutation-busy;
                                                reset-generation: root.page-generation;
                                                position-previewed(position) => { root.dpi-position-previewed(index, "x", position); }
                                                position-released(position) => { root.dpi-position-released(index, "x", position); }
                                                value-committed(value) => { root.dpi-value-edited(index, "x", value) }
                                                reference-selected(value) => { root.dpi-reference-selected(index, "x", value); }
                                            }
                                            if row.separate: DpiSliderControl {
                                                label: "Y"; value: row.y; position: row.y-position;
                                                minimum: root.dashboard.dpi-min; maximum: root.dashboard.dpi-max; step: root.dashboard.dpi-step; references: root.dpi-references;
                                                enabled: !root.mutation-busy;
                                                reset-generation: root.page-generation;
                                                position-previewed(position) => { root.dpi-position-previewed(index, "y", position); }
                                                position-released(position) => { root.dpi-position-released(index, "y", position); }
                                                value-committed(value) => { root.dpi-value-edited(index, "y", value) }
                                                reference-selected(value) => { root.dpi-reference-selected(index, "y", value); }
                                            }
                                            if root.dashboard.dpi-independent-axes: ToggleControl {
                                                label: "Separate X / Y"; value: row.separate;
                                                enabled: !root.mutation-busy;
                                                toggled => { root.dpi-separate-requested(index); }
                                            }
                                            if root.dashboard.show-lod: SelectControl {
                                                label: "Lift-off Distance";
                                                options: root.lod-options;
                                                current-index: row.option-index;
                                                enabled: !root.mutation-busy && row.persisted;
                                                selected(option-index) => { root.lod-selected(index + 1, option-index); }
                                            }
                                            HorizontalLayout {
                                                spacing: 10px;
                                                if !row.persisted: AppButton { size: ButtonSize.compact; fill: true; variant: ButtonVariant.accent; text: "Apply"; enabled: !root.mutation-busy; clicked => { root.dpi-apply-requested(index); } }
                                                if !row.active: AppButton { size: ButtonSize.compact; fill: true; variant: ButtonVariant.accent; text: "Use"; enabled: !root.mutation-busy && row.persisted; clicked => { root.active-dpi-requested(index + 1); } }
                                                AppButton { size: ButtonSize.compact; fill: true; variant: ButtonVariant.danger; text: "Remove"; enabled: !root.mutation-busy && root.dpi-rows.length > 1; clicked => { root.dpi-remove-requested(index); } }
                                            }
                                        }
                                    }
                                    if root.dpi-rows.length < root.dashboard.dpi-max-stages: HorizontalLayout {
                                        spacing: 10px;
                                        AppButton { size: ButtonSize.compact; fill: true; variant: ButtonVariant.neutral; text: root.mutation-busy ? "Saving..." : "Add Stage"; enabled: !root.mutation-busy; clicked => { root.dpi-add-requested(); } }
                                    }
                                }
                            }

                            if root.dashboard.show-polling: Rectangle {
                                border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                                VerticalLayout {
                                    padding: 15px; spacing: 6px;
                                    Text { text: "Polling"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                                    if root.dashboard.show-wireless-polling: SelectControl {
                                        label: "Wireless"; options: root.wireless-polling-options; current-index: root.dashboard.wireless-polling-index; enabled: !root.mutation-busy;
                                        selected(index) => { root.choice-selected("wireless-polling", index); }
                                    }
                                    if root.dashboard.show-wired-polling: SelectControl {
                                        label: "Wired"; options: root.wired-polling-options; current-index: root.dashboard.wired-polling-index; enabled: !root.mutation-busy;
                                        selected(index) => { root.choice-selected("wired-polling", index); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            vertical-stretch: 0;

                            if root.dashboard.show-power: Rectangle {
                                vertical-stretch: 0;
                                border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                                VerticalLayout {
                                    padding: 15px; spacing: 6px;
                                    Text { text: "Power Management"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                                    if root.dashboard.show-sleep-timer: SliderNumericControl {
                                        label: "Sleep Timer"; value: root.dashboard.sleep-timer-edit; unit: "min";
                                        minimum: root.dashboard.sleep-timer-min; maximum: root.dashboard.sleep-timer-max; step: root.dashboard.sleep-timer-step; enabled: !root.mutation-busy;
                                        reset-generation: root.page-generation;
                                        previewed(value) => { root.numeric-value-previewed("sleep-timer", value); }
                                        committed(value) => { root.numeric-value-edited("sleep-timer", value) }
                                    }
                                    if root.dashboard.show-low-power-mode: ToggleControl {
                                        label: "Low Power Mode"; value: root.dashboard.low-power-enabled; enabled: !root.mutation-busy;
                                        toggled => { root.toggle-requested("low-power"); }
                                    }
                                    if root.dashboard.show-low-power-polling: SelectControl {
                                        label: "Low Power Polling"; options: root.low-power-polling-options; current-index: root.dashboard.low-power-polling-index; enabled: !root.mutation-busy;
                                        selected(index) => { root.choice-selected("low-power-polling", index); }
                                    }
                                    if root.dashboard.show-auto-low-power: ToggleControl {
                                        label: "Auto Low Power"; value: root.dashboard.auto-low-power-enabled; enabled: !root.mutation-busy;
                                        toggled => { root.toggle-requested("auto-low-power"); }
                                    }
                                    if root.dashboard.show-auto-low-power: SliderNumericControl {
                                        label: "Auto Low Power Threshold"; value: root.dashboard.auto-low-power-threshold-edit; unit: "%";
                                        minimum: root.dashboard.auto-low-power-threshold-min; maximum: root.dashboard.auto-low-power-threshold-max; step: root.dashboard.auto-low-power-threshold-step; enabled: !root.mutation-busy;
                                        reset-generation: root.page-generation;
                                        previewed(value) => { root.numeric-value-previewed("auto-low-power-threshold", value); }
                                        committed(value) => { root.numeric-value-edited("auto-low-power-threshold", value) }
                                    }
                                }
                            }

                            if root.dashboard.show-wireless-stability || root.dashboard.show-bluetooth-smoothing: Rectangle {
                                vertical-stretch: 0;
                                border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                                VerticalLayout {
                                    padding: 15px; spacing: 6px;
                                    Text { text: "Wireless"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                                    if root.dashboard.show-wireless-stability: ToggleControl {
                                        label: "Wireless Stability Enhancement"; value: root.dashboard.wireless-stability-enabled; enabled: !root.mutation-busy;
                                        toggled => { root.toggle-requested("wireless-stability"); }
                                    }
                                    if root.dashboard.show-bluetooth-smoothing: ToggleControl {
                                        label: "Bluetooth Smoothing"; value: root.dashboard.bluetooth-smoothing-enabled; enabled: !root.mutation-busy;
                                        toggled => { root.toggle-requested("bluetooth-smoothing"); }
                                    }
                                }
                            }

                            if root.dashboard.show-scroll-jump: Rectangle {
                                vertical-stretch: 0;
                                border-radius: 9px; border-width: 1px; border-color: #323232; background: #1b1b1b;
                                VerticalLayout {
                                    padding: 15px; spacing: 6px;
                                    Text { text: "Scroll Jump Protection"; color: #f0f0f0; font-size: 17px; font-weight: 600; }
                                    ToggleControl {
                                        label: "State"; value: root.dashboard.scroll-jump-enabled; enabled: !root.mutation-busy;
                                        toggled => { root.toggle-requested("scroll-jump"); }
                                    }
                                    SliderNumericControl {
                                        label: "Delay"; value: root.dashboard.scroll-jump-delay-edit; unit: root.dashboard.scroll-jump-delay-unit;
                                        minimum: root.dashboard.scroll-jump-delay-min; maximum: root.dashboard.scroll-jump-delay-max; step: root.dashboard.scroll-jump-delay-step; enabled: !root.mutation-busy;
                                        reset-generation: root.page-generation;
                                        previewed(value) => { root.numeric-value-previewed("scroll-jump-delay", value); }
                                        committed(value) => { root.numeric-value-edited("scroll-jump-delay", value) }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}
