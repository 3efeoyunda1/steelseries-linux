// Shared dimensions for buttons and their specialized layout contexts.
export global ButtonMetrics {
    out property <length> compact-height: 28px;
    out property <length> compact-min-width: 34px;
    out property <length> compact-horizontal-padding: 10px;
    out property <length> toolbar-height: 30px;
    out property <length> toolbar-width: 96px;
    out property <length> large-height: 38px;
    out property <length> large-min-width: 100px;
    out property <length> large-horizontal-padding: 16px;
    out property <length> toggle-width: 56px;
    out property <length> priority-arrow-width: 34px;
}

export global ControlMetrics {
    out property <length> numeric-input-width: 88px;
    out property <length> select-width: 168px;
}

export global ButtonPalette {
    out property <color> danger-normal: #b7352e;
    out property <color> danger-hover: #c74038;
    out property <color> danger-pressed: #9f2b25;
    out property <color> danger-text: #fff8f2;
}
